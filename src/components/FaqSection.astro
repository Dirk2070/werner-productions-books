---
import { loadFaqs } from "../lib/load-faqs.js";

const hubFaqs = loadFaqs();

// DE-only rendering: map hub_faq → component render shape
// (q_de + a_short_de for HTML + JSON-LD; EN phase follows)
const faqs = hubFaqs.map((f) => ({ q: f.q_de, a: f.a_short_de.trim() }));

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a,
    },
  })),
};
---

<section class="faq" id="faq">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="faq__inner">
    <h2 class="faq__heading">Häufige Fragen</h2>
    <dl class="faq__list">
      {faqs.map((f) => (
        <details class="faq__item">
          <summary class="faq__question">{f.q}</summary>
          <p class="faq__answer">{f.a}</p>
        </details>
      ))}
    </dl>
  </div>
</section>

<style>
  .faq {
    padding: 2.5rem 1.5rem;
    background: #12122a;
    border-top: 1px solid #2d2d4e;
  }
  .faq__inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .faq__heading {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #7060a0;
    margin: 0 0 1.25rem;
  }
  .faq__list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .faq__item {
    border: 1px solid #2d2d4e;
    border-radius: 6px;
    background: #16162e;
    padding: 0.8rem 1rem;
  }
  .faq__item[open] {
    border-color: #c9a96e;
  }
  .faq__question {
    color: #c9a96e;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .faq__question::-webkit-details-marker {
    display: none;
  }
  .faq__question::before {
    content: "+";
    margin-right: 0.5rem;
    color: #7060a0;
  }
  .faq__item[open] .faq__question::before {
    content: "−";
  }
  .faq__answer {
    color: #b0a0d0;
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0.75rem 0 0;
  }
</style>
