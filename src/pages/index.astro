---
import { loadBooks } from "../lib/load-books.js";
import SiteHeader from "../components/SiteHeader.astro";
import IndexHero from "../components/IndexHero.astro";
import BookGrid from "../components/BookGrid.astro";
import AppsSection from "../components/AppsSection.astro";
import SocialLinks from "../components/SocialLinks.astro";
import FaqSection from "../components/FaqSection.astro";
import PressQuote from "../components/PressQuote.astro";
import FocusBadge from "../components/FocusBadge.astro";
import CrossLinkingFooter from "../components/CrossLinkingFooter.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { organizationNode, personRef, PERSON_ID } from "../lib/organization.js";

const books = await loadBooks();

const BASE_URL = "https://books.werner-productions.com";

// JSON-LD: Person + WebSite + ProfilePage @graph (commit 65ee79e — DO NOT MODIFY)
// Ausnahme von der Sperre, 2026-10-12, ausdrückliche Freigabe Dirks (Entscheidung
// vom 2026-10-11, books an werner-identity angleichen): der eigene Person-Knoten
// `#author` ist durch den Verweis auf den Apex-Anker `#person` ersetzt
// (personRef(), src/lib/organization.ts); alle Verweise darauf zeigen auf
// PERSON_ID. Die Eigenschaften der Person pflegt der Apex. Sonst unberührt,
// auch `#practice`.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    personRef(),
    {
      "@type": ["MedicalBusiness", "ProfessionalService"],
      "@id": `${BASE_URL}/#practice`,
      "name": "Praxis Dirk Werner — Psychologischer Psychotherapeut",
      "founder": { "@id": PERSON_ID },
      "employee": { "@id": PERSON_ID },
      "medicalSpecialty": "Psychiatric",
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": "Allgäu, Bayern"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Füssen-Hopfen am See",
        "addressRegion": "Bayern",
        "addressCountry": "DE"
      },
      "url": "https://werner-productions.com/",
      "sameAs": [
        "https://www.focus-gesundheit.de/arzt/dipl-psych-dirk-werner-4207595"
      ],
      "award": [
        "FOCUS-Empfehlung Gesundheit 2023 für Psychotherapie",
        "FOCUS-Empfehlung Gesundheit 2025 für Psychotherapie",
        "FOCUS-Empfehlung Gesundheit 2026 für Psychotherapie"
      ],
      "hasCredential": [
        {
          "@type": "EducationalOccupationalCredential",
          "credentialCategory": "Award",
          "name": "FOCUS-Empfehlung Gesundheit 2023 — Psychotherapie",
          "recognizedBy": {
            "@type": "Organization",
            "name": "FOCUS-Gesundheit",
            "url": "https://www.focus-gesundheit.de/"
          },
          "url": "https://www.focus-gesundheit.de/arzt/dipl-psych-dirk-werner-4207595",
          "dateCreated": "2023"
        },
        {
          "@type": "EducationalOccupationalCredential",
          "credentialCategory": "Award",
          "name": "FOCUS-Empfehlung Gesundheit 2025 — Psychotherapie",
          "recognizedBy": {
            "@type": "Organization",
            "name": "FOCUS-Gesundheit",
            "url": "https://www.focus-gesundheit.de/"
          },
          "url": "https://www.focus-gesundheit.de/arzt/dipl-psych-dirk-werner-4207595",
          "dateCreated": "2025"
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${BASE_URL}/#website`,
      "url": BASE_URL,
      "name": "Werner Productions Books",
      "description": "Bücher von Dirk Werner — Psychologie, Persönlichkeitsentwicklung und Fantasy",
      "publisher": {
        "@id": PERSON_ID
      },
      "inLanguage": ["de", "en"]
    },
    {
      "@type": "ProfilePage",
      "@id": `${BASE_URL}/#profilepage`,
      "url": BASE_URL,
      "name": "Dirk Werner — Autor-Profil",
      "isPartOf": {
        "@id": `${BASE_URL}/#website`
      },
      "about": {
        "@id": PERSON_ID
      },
      "mainEntity": {
        "@id": PERSON_ID
      }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dirk Werner — Bücher, Psychologie & Apps</title>
  <meta name="description" content="Bücher von Dirk Werner: Psychologie, Persönlichkeitsentwicklung und Fantasy-Romane. Diplom-Psychologe, Psychotherapeut, Autor." />
  <meta name="author" content="Dirk Werner" />
  <link rel="canonical" href={BASE_URL + "/"} />

  <!-- Open Graph -->
  <meta property="og:title" content="Dirk Werner — Bücher, Psychologie & Apps" />
  <meta property="og:description" content="Bücher von Dirk Werner: Psychologie, Persönlichkeitsentwicklung und Fantasy-Romane." />
  <meta property="og:type" content="profile" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:url" content={BASE_URL + "/"} />
  <!--
    ⛔ HIER STAND `dirk-werner.jpg` — das Autorenportraet im HOCHFORMAT
       (1125x2001). Messenger und Suchmaschinen schneiden ein Vorschaubild auf
       etwa 1,91:1 zu; von einem Hochformat bleibt ein Streifen aus der Mitte,
       beim Portraet also Hals und Jacke. Kaputt war nichts, es sah nur falsch
       aus — und das faellt niemandem auf, der den eigenen Link selten selbst
       verschickt.
    ⭐ `og-image.jpg` ist 1200x630 und traegt DASSELBE Bild vollstaendig, auf
       einem weichgezeichneten Ausschnitt seiner selbst. Das Original bleibt
       unveraendert: es wird sichtbar verwendet (IndexHero, AuthorCard) und
       steht als `image` am Person-Knoten, wo Hochformat richtig ist.
  -->
  <meta property="og:image" content={BASE_URL + "/assets/og-image.jpg"} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={BASE_URL + "/assets/og-image.jpg"} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <!-- Verlagsknoten (organization.ts), bewusst als eigener Block neben dem gesperrten Graphen; @id wie auf den Buchseiten -->
  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": [organizationNode()] })} />

  <link rel="stylesheet" href="/styles/book-detail.css" />
</head>
<body>
  <SiteHeader variant="full" />
  <main>
    <IndexHero />
    <BookGrid books={books} />
    <AppsSection />
    <SocialLinks />
    <FaqSection />
    <PressQuote />
    <FocusBadge />
  </main>
  <CrossLinkingFooter />
  <SiteFooter />
</body>
</html>
